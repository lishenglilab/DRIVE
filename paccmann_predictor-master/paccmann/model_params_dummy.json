    "stack_width": 10,
    "num_stacks": 2,
    "smiles_embedding_size": 32,
    "fc_hidden_sizes": [
        32,
        16
    ],
    "dropout": 0.1,
    "gene_embedding_size": 16,
    "gene_attention_size": 32,
    "final_activation": "sigmoid",
    "num_workers": 0
