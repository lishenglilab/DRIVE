// nextflow.config - FINAL ROUTER-BASED VERSION (with Voter Profile)

// ========================================================================================
//                              全局参数 (Global Parameters)
// ========================================================================================
params {
    // Define default values for parameters used across workflows
    gpu_id = 0
    test_dir = "${projectDir}/test"
    local_wheels_cp37 = "${projectDir}/local_wheels/cp37"
    local_wheels_cp38 = "${projectDir}/local_wheels/cp38"
    
    // 默认的 entry 为空，强制用户通过 profile 指定
    entry = '' 
}

// ========================================================================================
//                           配置文件定义 (Profile Definitions)
// ========================================================================================
profiles {

    // --- Profile 1: DeepCDR (using deepcdr6.yml) ---
    deepcdr {
        params.entry = 'deepcdr'
        process.conda = "${projectDir}/environments/deepcdr6.yml"
    }

    // --- Profile 2: DIPK & GraphDRP (using graphdrp_new.yml) ---
    dipk_graphdrp {
        params.entry = 'dipk_graphdrp'
        process.conda = "${projectDir}/environments/graphdrp_new.yml"
    }

    // --- Profile 3: Part 1 Models (using try2.yml) ---
    part1 {
        params.entry = 'part1'
        process.conda = "${projectDir}/environments/try2.yml"
    }
    
    // --- Profile 4: DeepAEG (using deepcdr.yml) ---
    deepaeg {
        params.entry = 'deepaeg'
        process.conda = "${projectDir}/environments/deepcdr.yml"
    }

    // --- 【【【 新增: Voter Profile 】】】 ---
    voter {
        // 设置 entry 参数以触发 main.nf 中的 voter 逻辑
        params.entry = 'voter'
        // 复用 part1 的 conda 环境，因为它包含了 pandas, numpy 等基础库
        process.conda = "${projectDir}/environments/try2.yml"
    }
}

// ========================================================================================
//                              全局Conda设置 (Global Conda Settings)
// ========================================================================================
conda {
    enabled = true
}

cleanup = true