// nextflow.config - V5 Final (Corrected for DSL2)

// ========================================================================================
//                              全局参数 (Global Parameters)
// ========================================================================================
// main.nf 中已定义所有参数的默认值。
// 此处可以留空，或为特定环境覆盖参数。
params {
    // 例如，如果您的服务器默认需要使用GPU 1，可以在这里设置
    // gpu_part1 = 1
}

// ========================================================================================
//                           配置文件定义 (Profile Definitions)
// ========================================================================================
profiles {
    deepcdr {
        params {
            entry = 'deepcdr'
        }
        process {
            conda = "${projectDir}/environments/deepcdr6.yml"
        }
    }

    dipk_graphdrp {
        params {
            entry = 'dipk_graphdrp'
        }
        process {
            conda = "${projectDir}/environments/graphdrp_new.yml"
        }
    }

    part1 {
        params {
            entry = 'part1'
        }
        process {
            conda = "${projectDir}/environments/try2.yml"
        }
    }
    
    deepaeg {
        params {
            entry = 'deepaeg'
        }
        process {
            conda = "${projectDir}/environments/deepcdr.yml"
        }
    }

    voter {
        params {
            entry = 'voter'
        }
        process {
            conda = "${projectDir}/environments/try2.yml"
        }
    }

    // 示例：一个在单GPU机器上运行的profile，设置所有GPU ID为0
    single_gpu {
        params {
            gpu_part1         = 0
            gpu_dipk_graphdrp = 0
            gpu_deepaeg       = 0
            gpu_deepcdr       = 0
        }
    }
}

// ========================================================================================
//                              全局设置
// ========================================================================================
// 默认启用 Conda
conda {
    enabled = true
}

// 在工作流成功完成后，自动清理 'work' 目录
cleanup = true